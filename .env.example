# Configuração do servidor (defina na Vercel: Settings → Environment Variables).
# NUNCA comite a chave real — este arquivo é só um modelo.

# Chave da API Anthropic (obrigatória para o gerador de SBAR por IA).
ANTHROPIC_API_KEY=sk-ant-...

# Chave da Groq (obrigatória para a transcrição de áudio da aba "Gerar").
# Gratuita em https://console.groq.com — modelo whisper-large-v3.
GROQ_API_KEY=gsk_...

# Opcional — modelo usado. Padrão: claude-opus-4-8 (mais capaz).
# Para menor custo e mais velocidade, use: claude-sonnet-5
SBAR_MODEL=claude-opus-4-8
